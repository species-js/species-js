{
  "name": "@species-js/type-identity",
  "version": "0.0.0",
  "private": true,
  "description": "Type branding and tamper-resistant type identity for JavaScript types.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/species-js/species-js.git",
    "directory": "packages/type-identity"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/node/public.cjs",
  "module": "./dist/node/public.js",
  "types": "./src/public.d.ts",
  "unpkg": "./dist/umd/public.umd.js",
  "jsdelivr": "./dist/umd/public.umd.js",
  "imports": {
    "#index": "./src/index.js",
    "#public": "./src/public.js",
    "#config": "./src/config/index.js"
  },
  "exports": {
    ".": {
      "types": "./src/public.d.ts",
      "browser": {
        "import": "./dist/browser/public.js"
      },
      "node": {
        "import": "./dist/node/public.js",
        "require": "./dist/node/public.cjs"
      },
      "default": "./dist/node/public.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "browserslist": [
    "chrome >= 80",
    "firefox >= 74",
    "safari >= 13.1",
    "edge >= 80"
  ],
  "dependencies": {
    "@species-js/type-detection": "workspace:^"
  },
  "scripts": {
    "build": "pnpm run build:node && pnpm run build:browser && pnpm run build:umd",
    "build:node": "cross-env SPECIES_BUILD_TARGET=node vite build",
    "build:browser": "cross-env SPECIES_BUILD_TARGET=browser vite build",
    "build:umd": "cross-env SPECIES_BUILD_TARGET=umd vite build",
    "clean": "node -e \"import('node:fs').then(fs => { for (const d of ['dist', 'coverage']) fs.rmSync(d, { recursive: true, force: true }); })\"",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --pretty"
  }
}
