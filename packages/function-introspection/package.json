{
  "name": "@species-js/function-introspection",
  "version": "0.0.0",
  "description": "Function classification and structural introspection for JavaScript callables.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/species-js/species-js.git",
    "directory": "packages/function-introspection"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/node/public.cjs",
  "module": "./dist/node/public.js",
  "types": "./src/public.d.ts",
  "unpkg": "./dist/umd/public.umd.js",
  "jsdelivr": "./dist/umd/public.umd.js",
  "imports": {
    "#index": "./src/index.js",
    "#public": "./src/public.js",
    "#config": "./src/config/index.js",
    "#utility": "./src/utility/index.js",
    "#bound": "./src/bound.js",
    "#arrow": "./src/arrow.js",
    "#concise": "./src/concise.js"
  },
  "exports": {
    ".": {
      "types": "./src/public.d.ts",
      "browser": {
        "import": "./dist/browser/public.js"
      },
      "node": {
        "import": "./dist/node/public.js",
        "require": "./dist/node/public.cjs"
      },
      "default": "./dist/node/public.js"
    },
    "./utility": {
      "types": "./src/utility/index.d.ts",
      "browser": {
        "import": "./dist/browser/utility.js"
      },
      "node": {
        "import": "./dist/node/utility.js",
        "require": "./dist/node/utility.cjs"
      },
      "default": "./dist/node/utility.js"
    },
    "./bound": {
      "types": "./src/bound.d.ts",
      "browser": {
        "import": "./dist/browser/bound.js"
      },
      "node": {
        "import": "./dist/node/bound.js",
        "require": "./dist/node/bound.cjs"
      },
      "default": "./dist/node/bound.js"
    },
    "./arrow": {
      "types": "./src/arrow.d.ts",
      "browser": {
        "import": "./dist/browser/arrow.js"
      },
      "node": {
        "import": "./dist/node/arrow.js",
        "require": "./dist/node/arrow.cjs"
      },
      "default": "./dist/node/arrow.js"
    },
    "./concise": {
      "types": "./src/concise.d.ts",
      "browser": {
        "import": "./dist/browser/concise.js"
      },
      "node": {
        "import": "./dist/node/concise.js",
        "require": "./dist/node/concise.cjs"
      },
      "default": "./dist/node/concise.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "browserslist": [
    "chrome >= 80",
    "firefox >= 74",
    "safari >= 13.1",
    "edge >= 80"
  ],
  "dependencies": {
    "@species-js/type-detection": "workspace:*"
  },
  "scripts": {
    "build": "pnpm run build:node && pnpm run build:browser && pnpm run build:umd",
    "build:node": "cross-env SPECIES_BUILD_TARGET=node vite build",
    "build:browser": "cross-env SPECIES_BUILD_TARGET=browser vite build",
    "build:umd": "cross-env SPECIES_BUILD_TARGET=umd vite build",
    "clean": "node -e \"import('node:fs').then(fs => { for (const d of ['dist', 'coverage']) fs.rmSync(d, { recursive: true, force: true }); })\"",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --pretty"
  }
}
